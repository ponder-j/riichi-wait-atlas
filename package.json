{
  "name": "riichi-wait-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node tools/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "enumerate": "clang++ -O3 -std=c++17 tools/enumerate.cpp -o tools/enumerate && ./tools/enumerate data/raw",
    "verify": "clang++ -O3 -std=c++17 tools/verify.cpp -o tools/verify && ./tools/verify data/raw",
    "test": "node tools/check.mjs && node tools/check-wait-search.mjs && node tools/check-patterns.mjs && node tools/check-abstractions.mjs",
    "enumerate:shapes": "clang++ -O3 -std=c++17 tools/enumerate-shapes.cpp -o tools/enumerate-shapes && ./tools/enumerate-shapes data/shape-raw",
    "compile:cores": "clang++ -O3 -std=c++17 tools/compile-cores.cpp -o tools/compile-cores && ./tools/compile-cores",
    "verify:patterns": "clang++ -O3 -std=c++17 tools/verify-patterns.cpp -o tools/verify-patterns && ./tools/verify-patterns data/raw && ./tools/verify-patterns data/shape-raw shape",
    "prepare:patterns": "node tools/prepare-patterns.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.2.0"
  },
  "description": "An exhaustive riichi mahjong wait atlas with exact wait-to-hand search and 355,313 canonical hands.",
  "homepage": "https://ponder-j.github.io/riichi-wait-atlas/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ponder-j/riichi-wait-atlas.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
